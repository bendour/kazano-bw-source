"UnlitGeneric"
{
   "$basetexture" "z_hadez/nuke/nuke"
   "$vertexcolor" 		1
   "$vertexalpha" 		1 
   "$nolod" 	1
   "$translucent" 1
   "Proxies"
   {
      "AnimatedTexture"
      {
         "animatedtexturevar" "$basetexture"
         "animatedtextureframenumvar" "$frame"
         "animatedtextureframerate" "16"
      }
   }
}